    "bodyHtml": "<style>\n@media (min-width:861px){\n  body:has(#page-event.page.active) .container{max-width:100%;}\n}\n#page-event .support-card--wide{max-width:100%;}\n#page-event .event-container{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px;margin-top:16px;}\n@media (max-width:820px){#page-event .event-container{grid-template-columns:1fr;}}\n#page-event .event-block{border:1px solid rgba(255,255,255,.10);border-radius:20px;background:rgba(255,255,255,.03);padding:18px;}\n#page-event .event-block__title{font-family:'Kaisei Tokumin',serif;font-size:20px;font-weight:800;color:#ff79b0;letter-spacing:.03em;}\n#page-event .event-block__date{color:#b6b6c2;font-size:13px;margin-top:4px;}\n#page-event .event-desc{font-size:14px;line-height:1.8;margin:10px 0 14px;}\n#page-event .video-embed{position:relative;padding-top:56.25%;background:#000;}\n#page-event .video-embed iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0;}\n#page-event .event-media-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}\n#page-event .event-cell{display:flex;flex-direction:column;border-radius:16px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);overflow:hidden;}\n#page-event .event-cell--stream .video-embed,#page-event .event-cell--mv .video-embed{border-radius:0;}\n#page-event .event-cell--goods{align-items:center;text-align:center;padding:14px;}\n#page-event .event-cell--goods a{display:block;width:100%;border-radius:12px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease;}\n#page-event .event-cell--goods a:hover{transform:scale(1.04);box-shadow:0 8px 20px rgba(0,0,0,.35);}\n#page-event .event-cell--goods img{width:100%;border-radius:12px;object-fit:cover;aspect-ratio:1/1;display:block;}\n#page-event .event-cell--contest{align-items:center;justify-content:center;text-align:center;padding:14px;}\n#page-event .event-cell--contest a{display:block;width:100%;border-radius:12px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease;}\n#page-event .event-cell--contest a:hover{transform:scale(1.04);box-shadow:0 8px 20px rgba(0,0,0,.35);}\n#page-event .event-cell--contest img,#page-event .event-cell--contest video{width:100%;border-radius:12px;object-fit:cover;aspect-ratio:1/1;display:block;}\n#page-event .event-cell--soon{align-items:center;justify-content:center;text-align:center;padding:16px 10px;border-style:dashed;opacity:.7;aspect-ratio:16/9;}\n#page-event .event-cell--soon h4{margin:0 0 6px;font-size:14px;display:flex;align-items:center;justify-content:center;gap:6px;}\n#page-event .event-cell--soon p{margin:0;font-size:12px;color:#b6b6c2;}\n#page-event .event-contest-pending{display:inline-block;font-size:12px;color:#cbd5e1;background:rgba(148,163,184,.12);border:1px dashed rgba(148,163,184,.4);border-radius:999px;padding:8px 14px;}\n@media (max-width:820px){\n#page-event .event-container{gap:0;}\n#page-event .event-block{border:none;border-radius:0;background:transparent;padding:20px 0;border-bottom:1px solid rgba(255,255,255,.14);}\n#page-event .event-block:last-child{border-bottom:none;}\n#page-event .event-cell--stream,#page-event .event-cell--mv{grid-column:1/-1;}\n}\n</style>\n<div class=\"support-card support-card--wide\"><div class=\"support-top-stripe\"></div><div class=\"support-inner\"><div class=\"support-header\"><div class=\"support-main-title\">Events</div><div class=\"support-sub-title\">Videos, goods, and streams for every event</div><div class=\"support-deco-line\">♡ ♡ ♡</div></div>\n\n<div class=\"event-container\">\n\n<div class=\"event-block\">\n  <div class=\"event-block__title\">1st Anniversary</div>\n  <div class=\"event-block__date\">January 3, 2027</div>\n  <p class=\"event-desc\">Mitarai Asobu is turning 1...! Look forward to it 🤍</p>\n  <div class=\"event-media-grid\">\n    <div class=\"event-cell event-cell--soon\">\n      <h4>📡 Stream</h4>\n      <p class=\"muted\">Coming soon...🦝</p>\n    </div>\n    <div class=\"event-cell event-cell--soon\">\n      <h4>🎬 MV</h4>\n      <p class=\"muted\">Coming soon...🦝</p>\n    </div>\n    <div class=\"event-cell event-cell--soon\">\n      <h4>🛍️ Goods</h4>\n      <p class=\"muted\">Coming soon...🦝</p>\n    </div>\n    <div class=\"event-cell event-cell--soon\">\n      <h4>🎨 Contest</h4>\n      <p class=\"muted\">Coming soon...🦝</p>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-block\">\n  <div class=\"event-block__title\">Mitarai THE Summer</div>\n  <div class=\"event-block__date\">Live Stream Aug 29, 2026 (Sat) 15:00〜</div>\n  <p class=\"event-desc\">Games, songs, and even suspense!? A summer festival event ☀</p>\n  <div class=\"event-media-grid\">\n    <div class=\"event-cell event-cell--stream\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/jm-2KiEF-Zs\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--mv\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/PEUCJ7274jM\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--goods\">\n      <a href=\"https://mitaraiasobu.booth.pm/items/8641060\" target=\"_blank\" rel=\"noopener\">\n        <img src=\"./assets/御手洗THEサマーグッズ.png\" alt=\"Mitarai THE Summer Goods\">\n      </a>\n    </div>\n    <div class=\"event-cell event-cell--contest\">\n      <span class=\"event-contest-pending\">Illustration contest results coming soon</span>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-block\">\n  <div class=\"event-block__title\">3,000 Subscribers Celebration</div>\n  <div class=\"event-block__date\">Live Stream Apr 25, 2026 (Sat) 21:00〜</div>\n  <p class=\"event-desc\">Welcoming spring in a new outfit! My first original MV</p>\n  <div class=\"event-media-grid\">\n    <div class=\"event-cell event-cell--stream\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/6aWcyKT8uh0\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--mv\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/dW6JQ9IP2Ao\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--goods\">\n      <a href=\"https://mitaraiasobu.booth.pm/items/8274978\" target=\"_blank\" rel=\"noopener\">\n        <img src=\"./assets/3000-2.png\" alt=\"Jyumyou:3000\">\n      </a>\n    </div>\n    <div class=\"event-cell event-cell--contest\">\n      <img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" alt=\"\" style=\"display:none\" onload=\"var w=[{type:'img',src:'./assets/ブルー.png',alt:'Round 2 Illustration Contest — Full-body Award: ブルー'},{type:'img',src:'./assets/えびなちょす.png',alt:'Round 2 Illustration Contest — Special Award: えびなちょす'},{type:'video',src:'./assets/しののん.mp4',alt:'Round 2 Illustration Contest — Animation Award: しののん'}];var p=w[Math.floor(Math.random()*w.length)];var a=document.createElement('a');a.href='#contest-round2';a.onclick=function(e){e.preventDefault();gotoContestAnchor('contest-round2');};var el;if(p.type==='video'){el=document.createElement('video');el.src=p.src;el.autoplay=true;el.muted=true;el.loop=true;el.playsInline=true;}else{el=document.createElement('img');el.src=p.src;}el.alt=p.alt;a.appendChild(el);this.parentElement.appendChild(a);this.remove();\">\n    </div>\n  </div>\n</div>\n\n<div class=\"event-block\">\n  <div class=\"event-block__title\">Debut Anniversary</div>\n  <div class=\"event-block__date\">Live Stream Jan 3, 2026 (Sat) 20:00〜</div>\n  <p class=\"event-desc\">The day we celebrated my birthday and debut together 🖤 Featuring my first cover song video too!</p>\n  <div class=\"event-media-grid\">\n    <div class=\"event-cell event-cell--stream\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/OUEHTFDx-Sw\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--mv\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/W09Mn6onF5Q\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--goods\">\n      <a href=\"https://mitaraiasobu.booth.pm/items/7769361\" target=\"_blank\" rel=\"noopener\">\n        <img src=\"./assets/goods_debut.png\" alt=\"Debut Goods\">\n      </a>\n    </div>\n    <div class=\"event-cell event-cell--contest\">\n      <img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" alt=\"\" style=\"display:none\" onload=\"var w=[{img:'./assets/ミードリ.png',alt:'Round 1 Illustration Contest — Full-body Award: ミードリ'},{img:'./assets/るぇるん.png',alt:'Round 1 Illustration Contest — Chibi Award: るぇるん'},{img:'./assets/おれお.png',alt:'Round 1 Illustration Contest — Special Award: おれお'}];var p=w[Math.floor(Math.random()*w.length)];var a=document.createElement('a');a.href='#contest-results';a.onclick=function(e){e.preventDefault();gotoContestAnchor('contest-results');};var im=document.createElement('img');im.src=p.img;im.alt=p.alt;a.appendChild(im);this.parentElement.appendChild(a);this.remove();\">\n    </div>\n  </div>\n</div>\n\n</div>\n\n<div class=\"support-footer\"><div class=\"support-footer-hearts\">♡ ♡ ♡</div><div class=\"support-footer-name\">Mitarai Asobu</div><div class=\"support-footer-roman\">Mitarai Asobu</div></div></div></div>"
