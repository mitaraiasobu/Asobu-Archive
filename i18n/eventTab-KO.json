se64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" alt=\"\" style=\"display:none\" onload=\"var w=[{type:'img',src:'./assets/ブルー.png',alt:'제2회 일러스트 콘테스트 등신상: ブルー'},{type:'img',src:'./assets/えびなちょす.png',alt:'제2회 일러스트 콘테스트 특별상: えびなちょす'},{type:'video',src:'./assets/しののん.mp4',alt:'제2회 일러스트 콘테스트 애니메이션상: しののん'}];var p=w[Math.floor(Math.random()*w.length)];var a=document.createElement('a');a.href='#contest-round2';a.onclick=function(e){e.preventDefault();gotoContestAnchor('contest-round2');};var el;if(p.type==='video'){el=document.createElement('video');el.src=p.src;el.autoplay=true;el.muted=true;el.loop=true;el.playsInline=true;}else{el=document.createElement('img');el.src=p.src;}el.alt=p.alt;a.appendChild(el);this.parentElement.appendChild(a);this.remove();\">\n    </div>\n  </div>\n</div>\n\n<div class=\"event-block\">\n  <div class=\"event-block__title\">데뷔 기념</div>\n  <div class=\"event-block__date\">생방송 2026년 1월 3일(토) 20:00〜</div>\n  <p class=\"event-desc\">생일과 데뷔를 동시에 축하한 날이야🖤 첫 커버곡 영상도!</p>\n  <div class=\"event-media-grid\">\n    <div class=\"event-cell event-cell--stream\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/OUEHTFDx-Sw\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--mv\">\n      <div class=\"video-embed\"><iframe src=\"https://www.youtube.com/embed/W09Mn6onF5Q\" frameborder=\"0\" allowfullscreen></iframe></div>\n    </div>\n    <div class=\"event-cell event-cell--goods\">\n      <a href=\"https://mitaraiasobu.booth.pm/items/7769361\" target=\"_blank\" rel=\"noopener\">\n        <img src=\"./assets/goods_debut.png\" alt=\"데뷔 굿즈\">\n      </a>\n    </div>\n    <div class=\"event-cell event-cell--contest\">\n      <img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==\" alt=\"\" style=\"display:none\" onload=\"var w=[{img:'./assets/ミードリ.png',alt:'제1회 일러스트 콘테스트 등신상: ミードリ'},{img:'./assets/るぇるん.png',alt:'제1회 일러스트 콘테스트 미니 캐릭터상: るぇるん'},{img:'./assets/おれお.png',alt:'제1회 일러스트 콘테스트 특별상: おれお'}];var p=w[Math.floor(Math.random()*w.length)];var a=document.createElement('a');a.href='#contest-results';a.onclick=function(e){e.preventDefault();gotoContestAnchor('contest-results');};var im=document.createElement('img');im.src=p.img;im.alt=p.alt;a.appendChild(im);this.parentElement.appendChild(a);this.remove();\">\n    </div>\n  </div>\n</div>\n\n</div>\n\n<div class=\"support-footer\"><div class=\"support-footer-hearts\">♡ ♡ ♡</div><div class=\"support-footer-name\">미타라이 아소부</div><div class=\"support-footer-roman\">Mitarai Asobu</div></div></div></div>"
