    "bodyHtml": "<style>\n@media (min-width:861px){\n  body:has(#page-event.page.active) .container{max-width:100%;}\n}\n#page-event .support-card--wide{max-width:100%;}\n#page-event .event-container{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px;margin-top:16px;}\n@media (max-width:820px){#page-event .event-container{grid-template-columns:1fr;}}\n#page-event .event-block{border:1px solid rgba(255,255,255,.10);border-radius:20px;background:rgba(255,255,255,.03);padding:18px;}\n#page-event .event-block__title{font-family:'Kaisei Tokumin',serif;font-size:20px;font-weight:800;color:#ff79b0;letter-spacing:.03em;}\n#page-event .event-block__date{color:#b6b6c2;font-size:13px;margin-top:4px;}\n#page-event .event-desc{font-size:14px;line-height:1.8;margin:10px 0 14px;}\n#page-event .video-embed{position:relative;padding-top:56.25%;background:#000;}\n#page-event .video-embed iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0;}\n#page-event .event-media-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}\n#page-event .event-cell{display:flex;flex-direction:column;border-radius:16px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);overflow:hidden;}\n#page-event .event-cell--stream .video-embed,#page-event .event-cell--mv .video-embed{border-radius:0;}\n#page-event .event-cell--goods{align-items:center;text-align:center;padding:14px;}\n#page-event .event-cell--goods a{display:block;width:100%;border-radius:12px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease;}\n#page-event .event-cell--goods a:hover{transform:scale(1.04);box-shadow:0 8px 20px rgba(0,0,0,.35);}\n#page-event .event-cell--goods img{width:100%;border-radius:12px;object-fit:cover;aspect-ratio:1/1;display:block;}\n#page-event .event-cell--contest{align-items:center;justify-content:center;text-align:center;padding:14px;}\n#page-event .event-cell--contest a{display:block;width:100%;border-radius:12px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease;}\n#page-event .event-cell--contest a:hover{transform:scale(1.04);box-shadow:0 8px 20px rgba(0,0,0,.35);}\n#page-event .event-cell--contest img,#page-event .event-cell--contest video{width:100%;border-radius:12px;object-fit:cover;aspect-ratio:1/1;display:block;}\n#page-event .event-cell--soon{align-items:center;justify-content:center;text-align:center;padding:16px 10px;border-style:dashed;opacity:.7;aspect-ratio:16/9;}\n#page-event .event-cell--soon h4{margin:0 0 6px;font-size:14px;display:flex;align-items:center;justify-content:center;gap:6px;}\n#page-event .event-cell--soon p{margin:0;font-size:12px;color:#b6b6c2;}\n#page-event .event-contest-pending{display:inline-block;font-size:12px;color:#cbd5e1;background:rgba(148,163,184,.12);border:1px dashed rgba(148,163,184,.4);border-radius:999px;padding:8px 14px;}\n</style>\n<div class=\"support-card support-card--wide\"><div class=\"support-top-stripe\"></div><div class=\"support-inner\"><div class=\"support-header\"><div class=\"support-main-title\">이벤트</div><div class=\"support-sub-title\">이벤트별 영상·굿즈·방송 소개</div><div class=\"support-deco-line\">♡ ♡ ♡</div></div>\n\n<div class=\"event-container\">\n\n<div class=\"event-block\">\n  <div class=\"event-block__title\">1주년 기념</div>\n  <div class=\"event-block__date\">2027년 1월 3일</div>\n  <p class=\"event-desc\">미타라이 아소부, 드디어 1주년......! 기대하며 기다려줘 🤍</p>\n  <div class=\"event-media-grid\">\n    <div class=\"event-cell event-cell--soon\">\n      <h4>📡 방송</h4>\n      <p class=\"muted\">준비 중......🦝</p>\n    </div>\n    <div class=\"event-cell event-cell--soon\">\n      <h4>🎬 MV</h4>\n      <p class=\"muted\">준비 중......🦝</p>\n    </div>\n    <div class=\"event-cell event-cell--soon\">\n      <h4>🛍️ 굿즈</h4>\n      <p class=\"muted\">준비 중......🦝</p>\n    </div>\n    <div class=\"event-cell event-cell--soon\">\n      <h4>🎨 콘테스트</h4>\n      <p class=\"muted\">준비 중......🦝</p>\n    </div>\n  </div>\n</div>\n\n<div class=\"event-block\">\n  <div clas